              "Code": "using System;\nusing Models.Core;\nusing Models.PMF;\nusing Models.Soils;\nusing Models.Utilities;\nusing APSIM.Shared.Utilities;\n\nnamespace Models\n{\n    [Serializable]\n    public class Script : Model\n    {\n        [Link] Clock Clock;\n        [Link] Fertiliser Fertiliser;\n        [Link] Summary Summary;\n        [Link] Soil Soil;\n        Accumulator accumulatedRain;\n        \n        [Description(\"Crop\")]\n        public IPlant Crop { get; set; }\n        [Description(\"Sowing date (d-mmm)\")]\n        public string SowDate { get; set; }\n    [Display(Type = DisplayType.CultivarName)]\n        [Description(\"Cultivar to be sown\")]\n        public string CultivarName { get; set; }\n        [Description(\"Sowing depth (mm)\")]\n        public double SowingDepth { get; set; }\n        [Description(\"Row spacing (mm)\")]\n        public double RowSpacing { get; set; }\n        [Description(\"Plant population (/m2)\")]\n        public double Population { get; set; }\n        \n\n\n        [EventSubscribe(\"DoManagement\")]\n        private void OnDoManagement(object sender, EventArgs e)\n        {\n            if (DateUtilities.WithinDates(SowDate, Clock.Today, SowDate))\n            {\n                Crop.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    \n            }\n        \n        }\n        \n    }\n}\n",
              "Parameters": [
                {
                  "Key": "Crop",
                  "Value": "[Wheat]"
                },
                {
                  "Key": "SowDate",
                  "Value": "15-May"
                },
                {
                  "Key": "CultivarName",
                  "Value": "Hartog"
                },
                {
                  "Key": "SowingDepth",
                  "Value": "30"
                },
                {
                  "Key": "RowSpacing",
                  "Value": "250"
                },
                {
                  "Key": "Population",
                  "Value": "100"
                }
              ],
              "Name": "Sow on a fixed date",
              "IncludeInDocumentation": true,
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.MicroClimate, Models",
              "a_interception": 0.0,
              "b_interception": 1.0,
              "c_interception": 0.0,
              "d_interception": 0.0,
              "soil_albedo": 0.3,
              "SoilHeatFluxFraction": 0.4,
              "NightInterceptionFraction": 0.5,
              "ReferenceHeight": 2.0,
              "Name": "MicroClimate",
              "Children": [],
              "IncludeInDocumentation": false,
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "Code": "using System;\nusing Models.Core;\nusing Models.PMF;\nnamespace Models\n{\n    [Serializable]\n    public class Script : Model\n    {\n        [Link] Clock Clock;\n        [Link] Fertiliser Fertiliser;\n        [Link] Summary Summary;\n        \n        \n        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]\n        public double Amount { get; set;}\n        \n        [Description(\"Crop to be fertilised\")]\n        public string CropName { get; set;}\n        \n        \n        \n\n        [EventSubscribe(\"Sowing\")]\n        private void OnSowing(object sender, EventArgs e)\n        {\n            Model crop = sender as Model;\n            if (crop.Name.ToLower()==CropName.ToLower())\n                Fertiliser.Apply(Amount: Amount, Type: Fertiliser.Types.NO3N);\n        }\n        \n    }\n}\n",
              "Parameters": [
                {
                  "Key": "Amount",
                  "Value": "160"
                },
                {
                  "Key": "CropName",
                  "Value": "wheat"
                }
              ],
              "Name": "SowingFertiliser",
              "IncludeInDocumentation": false,
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "Code": "using System;\nusing Models.Core;\nusing Models.PMF;\nusing Models.Soils;\nusing Models.Soils.Nutrients;\nusing Models.Utilities;\nusing APSIM.Shared.Utilities;\n\nnamespace Models\n{\n    [Serializable]\n    public class Script : Model\n    {\n        [Link] Plant Wheat;\n\n        [EventSubscribe(\"DoManagement\")]\n        private void OnDoManagement(object sender, EventArgs e)\n        {\n            if (Wheat.IsReadyForHarvesting)\n            {\n               Wheat.Harvest();\n               Wheat.EndCrop();    \n            }\n        \n        }\n        \n    }\n}\n",
              "Parameters": [],
              "Name": "Harvest",
              "IncludeInDocumentation": false,
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Functions.MinimumFunction, Models",
              "Name": "Humidity9am",
              "Children": [
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Expression": "(([Weather].VP*0.1)/es)*100",
                  "Name": "RH",
                  "Children": [
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Expression": "6.1078*exp((17.269*Temp9am)/(273.3+Temp9am))*0.1",
                      "Name": "es",
                      "Children": [
                        {
                          "$type": "Models.Functions.ExpressionFunction, Models",
                          "Expression": "[Weather].MinT+(T_diff*t_fract)",
                          "Name": "Temp9am",
                          "Children": [
                            {
                              "$type": "Models.Functions.Constant, Models",
                              "FixedValue": 0.77345,
                              "Units": null,
                              "Name": "t_fract",
                              "Children": [],
                              "IncludeInDocumentation": false,
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Functions.SubtractFunction, Models",
                              "Name": "T_diff",
                              "Children": [
                                {
                                  "$type": "Models.Functions.ExternalVariable, Models",
                                  "VariableName": "[Weather].MaxT",
                                  "Name": "maxt",
                                  "Children": [],
                                  "IncludeInDocumentation": false,
                                  "Enabled": true,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Functions.ExternalVariable, Models",
                                  "VariableName": "[Weather].MinT",
                                  "Name": "mint",
                                  "Children": [],
                                  "IncludeInDocumentation": false,
                                  "Enabled": true,
                                  "ReadOnly": false
                                }
                              ],
                              "IncludeInDocumentation": false,
                              "Enabled": true,
                              "ReadOnly": false
                            }
                          ],
                          "IncludeInDocumentation": false,
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Memo, Models",
                          "Text": "EccelE, 2012 Meteorol. Appl. 19: 118–128 (2012) p.120: \n\nes = saturation water vapour pressure.  Calculated by a common empirical interpolation function (see, e.g., WMO, 1979; Holbo, 1981\n\n\nes = 6.1078 * exp (17.269 (T /(T + 237.3))",
                          "Name": "Memo",
                          "Children": [],
                          "IncludeInDocumentation": false,
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "IncludeInDocumentation": false,
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "IncludeInDocumentation": false,
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 100.0,
                  "Units": null,
                  "Name": "maximum",
                  "Children": [],
                  "IncludeInDocumentation": false,
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Memo, Models",
                  "Text": "\nEccelE, 2012 Meteorol. Appl. 19: 118–128 (2012) p.120: \n\nRelative humidity can be expressed as the ratio between actual water vapour and saturation vapour, which is, in turn, a pure function of temperature:\n\nRH = 100*(e/es)\n\nwhere e = actual water vapour pressure \n\nand   es=  saturation water vapour pressure.",
                  "Name": "Memo",
                  "Children": [],
                  "IncludeInDocumentation": false,
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "IncludeInDocumentation": false,
              "Enabled": true,
              "ReadOnly": false
            },
