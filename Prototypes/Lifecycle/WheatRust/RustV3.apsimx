                                  "IncludeInDocumentation": true,
                                  "Enabled": true,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Memo, Models",
                                  "Text": "Data based on the \n\n Response surface generated from the equation I = - 355'14 + 0-99T + 1'64T' -0'11 T' +292'99 (In W)- 48'26 (In W)\"-1 '5sT-(In W), where I = infection (%), T = temperature (0C) and W = wet period (h). Negative 1= O.\n\nAssumtion 12 hours of leaf wetness if rain previous day and humidity at 85% at 9am\n\nDENNIS  Trans. Br. mycol. Soc. 88 (1), (1987)\n\n",
                                  "Name": "Memo",
                                  "Children": [],
                                  "IncludeInDocumentation": true,
                                  "Enabled": true,
                                  "ReadOnly": false
                                }
                              ],
                              "IncludeInDocumentation": true,
                              "Enabled": true,
                              "ReadOnly": false
                            },
