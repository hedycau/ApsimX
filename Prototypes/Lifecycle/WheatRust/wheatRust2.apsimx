            {
              "$type": "Models.MicroClimate, Models",
              "a_interception": 0.0,
              "b_interception": 1.0,
              "c_interception": 0.0,
              "d_interception": 0.0,
              "soil_albedo": 0.3,
              "SoilHeatFluxFraction": 0.4,
              "NightInterceptionFraction": 0.5,
              "ReferenceHeight": 2.0,
              "Name": "MicroClimate",
              "Children": [],
              "IncludeInDocumentation": true,
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "Code": "using System;\nusing Models.Core;\nusing Models.PMF;\nnamespace Models\n{\n    [Serializable]\n    public class Script : Model\n    {\n        [Link] Clock Clock;\n        [Link] Fertiliser Fertiliser;\n        [Link] Summary Summary;\n        \n        \n        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]\n        public double Amount { get; set;}\n        \n        [Description(\"Crop to be fertilised\")]\n        public string CropName { get; set;}\n        \n        \n        \n\n        [EventSubscribe(\"Sowing\")]\n        private void OnSowing(object sender, EventArgs e)\n        {\n            Model crop = sender as Model;\n            if (crop.Name.ToLower()==CropName.ToLower())\n                Fertiliser.Apply(Amount: Amount, Type: Fertiliser.Types.NO3N);\n        }\n        \n    }\n}\n",
              "Parameters": [
                {
                  "Key": "Amount",
                  "Value": "160"
                },
                {
                  "Key": "CropName",
                  "Value": "wheat"
                }
              ],
              "Name": "SowingFertiliser",
              "IncludeInDocumentation": true,
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "Code": "using System;\nusing Models.Core;\nusing Models.PMF;\nusing Models.Soils;\nusing Models.Soils.Nutrients;\nusing Models.Utilities;\nusing APSIM.Shared.Utilities;\n\nnamespace Models\n{\n    [Serializable]\n    public class Script : Model\n    {\n        [Link] Plant Wheat;\n\n        [EventSubscribe(\"DoManagement\")]\n        private void OnDoManagement(object sender, EventArgs e)\n        {\n            if (Wheat.IsReadyForHarvesting)\n            {\n               Wheat.Harvest();\n               Wheat.EndCrop();    \n            }\n        \n        }\n        \n    }\n}\n",
              "Parameters": [],
              "Name": "Harvest",
              "IncludeInDocumentation": true,
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "Code": "using System;\nusing Models.Core;\nusing Models.PMF;\nusing Models.Soils;\nusing Models.Soils.Nutrients;\nusing Models.Utilities;\nusing APSIM.Shared.Utilities;\n\nnamespace Models\n{\n    [Serializable]\n    public class Script : Model\n    {\n        [Link] Clock Clock;\n        [Link] Fertiliser Fertiliser;\n        [Link] Summary Summary;\n        [Link] Plant Wheat;\n        [Link] Soil Soil; \n        Accumulator accumulatedRain;\n        \n        [Description(\"Start of sowing window (d-mmm)\")]\n        public string StartDate { get; set;}\n        [Description(\"End of sowing window (d-mmm)\")]\n        public string EndDate { get; set;}\n        [Description(\"Minimum extractable soil water for sowing (mm)\")]\n        public double MinESW { get; set;}\n        [Description(\"Accumulated rainfall required for sowing (mm)\")]\n        public double MinRain { get; set;}\n        [Description(\"Duration of rainfall accumulation (d)\")]\n        public int RainDays { get; set;}\n        [Description(\"Cultivar to be sown\")]\n        [Display(Type=DisplayType.CultivarName)]\n        public string CultivarName { get; set;}\n        [Description(\"Sowing depth (mm)\")]\n        public double SowingDepth { get; set;}        \n        [Description(\"Row spacing (mm)\")]\n        public double RowSpacing { get; set;}    \n        [Description(\"Plant population (/m2)\")]\n        public double Population { get; set;}    \n        \n        \n        [EventSubscribe(\"Commencing\")]\n        private void OnSimulationCommencing(object sender, EventArgs e)\n        {\n            accumulatedRain = new Accumulator(this, \"[Weather].Rain\", RainDays);\n        }\n        \n\n        [EventSubscribe(\"DoManagement\")]\n        private void OnDoManagement(object sender, EventArgs e)\n        {\n            accumulatedRain.Update();\n            \n            if (DateUtilities.WithinDates(StartDate,Clock.Today,EndDate) &&\n                !Wheat.IsAlive &&\n                MathUtilities.Sum(Soil.SoilWater.ESW) > MinESW &&\n                accumulatedRain.Sum > MinRain)\n            {\n               Wheat.Sow(population:Population, cultivar:CultivarName, depth:SowingDepth, rowSpacing:RowSpacing);    \n            }\n        \n        }\n        \n    }\n}\n",
              "Parameters": [
                {
                  "Key": "StartDate",
                  "Value": "1-may"
                },
                {
                  "Key": "EndDate",
                  "Value": "10-jul"
                },
                {
                  "Key": "MinESW",
                  "Value": "100"
                },
                {
                  "Key": "MinRain",
                  "Value": "25"
                },
                {
                  "Key": "RainDays",
                  "Value": "7"
                },
                {
                  "Key": "CultivarName",
                  "Value": "Hartog"
                },
                {
                  "Key": "SowingDepth",
                  "Value": "30"
                },
                {
                  "Key": "RowSpacing",
                  "Value": "250"
                },
                {
                  "Key": "Population",
                  "Value": "120"
                }
              ],
              "Name": "SowingRule1",
              "IncludeInDocumentation": true,
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Functions.MinimumFunction, Models",
              "Name": "Humidity9am",
              "Children": [
                {
                  "$type": "Models.Functions.ExpressionFunction, Models",
                  "Expression": "(([Weather].VP*0.1)/es)*100",
                  "Name": "RH",
                  "Children": [
                    {
                      "$type": "Models.Functions.ExpressionFunction, Models",
                      "Expression": "6.1078*exp((17.269*Temp9am)/(273.3+Temp9am))*0.1",
                      "Name": "es",
                      "Children": [
                        {
                          "$type": "Models.Functions.ExpressionFunction, Models",
                          "Expression": "[Weather].MinT+(T_diff*t_fract)",
                          "Name": "Temp9am",
                          "Children": [
                            {
                              "$type": "Models.Functions.Constant, Models",
                              "FixedValue": 0.77345,
                              "Units": null,
                              "Name": "t_fract",
                              "Children": [],
                              "IncludeInDocumentation": true,
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Functions.SubtractFunction, Models",
                              "Name": "T_diff",
                              "Children": [
                                {
                                  "$type": "Models.Functions.ExternalVariable, Models",
                                  "VariableName": "[Weather].MaxT",
                                  "Name": "maxt",
                                  "Children": [],
                                  "IncludeInDocumentation": true,
                                  "Enabled": true,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Functions.ExternalVariable, Models",
                                  "VariableName": "[Weather].MinT",
                                  "Name": "mint",
                                  "Children": [],
                                  "IncludeInDocumentation": true,
                                  "Enabled": true,
                                  "ReadOnly": false
                                }
                              ],
                              "IncludeInDocumentation": true,
                              "Enabled": true,
                              "ReadOnly": false
                            }
                          ],
                          "IncludeInDocumentation": true,
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Memo, Models",
                          "Text": "EccelE, 2012 Meteorol. Appl. 19: 118–128 (2012) p.120: \n\nes = saturation water vapour pressure.  Calculated by a common empirical interpolation function (see, e.g., WMO, 1979; Holbo, 1981\n\n\nes = 6.1078 * exp (17.269 (T /(T + 237.3))",
                          "Name": "Memo",
                          "Children": [],
                          "IncludeInDocumentation": true,
                          "Enabled": true,
                          "ReadOnly": false
                        }
                      ],
                      "IncludeInDocumentation": true,
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "IncludeInDocumentation": true,
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 100.0,
                  "Units": null,
                  "Name": "maximum",
                  "Children": [],
                  "IncludeInDocumentation": true,
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Memo, Models",
                  "Text": "\nEccelE, 2012 Meteorol. Appl. 19: 118–128 (2012) p.120: \n\nRelative humidity can be expressed as the ratio between actual water vapour and saturation vapour, which is, in turn, a pure function of temperature:\n\nRH = 100*(e/es)\n\nwhere e = actual water vapour pressure \n\nand   es=  saturation water vapour pressure.",
                  "Name": "Memo",
                  "Children": [],
                  "IncludeInDocumentation": true,
                  "Enabled": true,
                  "ReadOnly": false
                }
              ],
              "IncludeInDocumentation": true,
              "Enabled": true,
              "ReadOnly": false
            },
